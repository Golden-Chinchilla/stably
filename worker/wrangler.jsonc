{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stably-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-11",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stably-db",
      "database_id": "26e0f8ed-5757-45f6-9a04-63460c784bae",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
